#: src/Admin/ConnectionSection.php:220
msgid "<strong>Gallop:</strong> <code>GALLOP_WP_API_KEY</code> is defined in wp-config.php but is not a valid key, so requests that need a key are refused. It must start with <code>gallopwp_</code> followed by at least 32 random letters and digits."
msgstr ""

